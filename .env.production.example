NODE_ENV=production
HOST=127.0.0.1
PORT=4000
API_ENV_FILE=.env.production
APP_ORIGIN=https://YOUR_DOMAIN
ADMIN_PHONE=+96555551234
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
AUTH_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
UPLOADS_DIR=/app/uploads
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=mysql://just4kids:DB_PASSWORD_VALUE@db:3306/just4kids
DOCKER_DATABASE_URL=mysql://just4kids:DB_PASSWORD_VALUE@db:3306/just4kids

# WhatsApp intake (phase 12). Leave every value empty to keep it off; a partial set refuses to start.
# OpenWA v0.25.0 runs as the compose `openwa` service: pnpm docker:up:whatsapp (see README "WhatsApp intake").
# Its session webhook for "message.received" points at http://api:4000/whatsapp/webhook with OPENWA_WEBHOOK_SECRET.
OPENWA_BASE_URL=http://openwa:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
# International format, e.g. +96550000000. Receives request summaries, updates and forwards.
STAFF_WHATSAPP_NUMBER=
# Any OpenAI-compatible Chat Completions provider, e.g. https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# OpenWA container. A master key of at least 32 characters, or empty to let OpenWA generate one into its data volume.
OPENWA_MASTER_KEY=
# Empty keeps OpenWA's default engine (whatsapp-web.js, runs Chromium); `baileys` needs no browser. Open decision.
OPENWA_ENGINE_TYPE=
# OpenWA's own default; whatsapp-web.js needs most of it.
OPENWA_MEM_LIMIT=2g
