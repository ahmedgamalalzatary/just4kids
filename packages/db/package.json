{
  "name": "@just4kids/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "import": "./dist/schema/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsc --project tsconfig.build.json --watch",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm db:migrate:test && vitest run --config ../../vitest.config.ts --project db",
    "test:watch": "pnpm db:migrate:test && vitest --config ../../vitest.config.ts --project db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config drizzle.test.config.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": { "drizzle-orm": "catalog:", "mysql2": "catalog:" },
  "devDependencies": {
    "@just4kids/config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
