NODE_ENV=development
HOST=127.0.0.1
PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
DATABASE_URL=mysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/just4kids
DOCKER_DATABASE_URL=mysql://YOUR_USER:YOUR_PASSWORD@host.docker.internal:3306/just4kids
APP_ORIGIN=http://localhost:3000
ADMIN_PHONE=+96555551234
ADMIN_PASSWORD=
AUTH_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
UPLOADS_DIR=uploads

# WhatsApp intake (phase 12). Leave every value empty to keep it off; a partial set refuses to start.
# OpenWA v0.25.0 gateway. Register its webhook for "message.received" at <API>/whatsapp/webhook with OPENWA_WEBHOOK_SECRET.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
# International format, e.g. +96550000000. Receives request summaries, updates and forwards.
STAFF_WHATSAPP_NUMBER=
# Any OpenAI-compatible Chat Completions provider, e.g. https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional: enabled or disabled, for providers that accept it. Xiaomi MiMo: use disabled.
AI_THINKING=
