{
  "name": "@just4kids/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @just4kids/db db:migrate:test && vitest run --config ../../vitest.config.ts --project api",
    "test:watch": "pnpm --filter @just4kids/db db:migrate:test && vitest --config ../../vitest.config.ts --project api"
  },
  "dependencies": {
    "@just4kids/contracts": "workspace:*",
    "@just4kids/db": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@just4kids/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
