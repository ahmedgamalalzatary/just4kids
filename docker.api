# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS base
RUN npm install --global pnpm@12.4.1
WORKDIR /repo

# Dependencies: only manifests, so source edits keep this layer cached.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
RUN --mount=type=cache,id=just4kids-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store --filter=@just4kids/api...

# Build: only the API and the packages it uses, so web edits never rebuild it.
FROM deps AS builder
COPY packages/config/ packages/config/
COPY packages/contracts/ packages/contracts/
COPY packages/db/ packages/db/
COPY apps/api/ apps/api/
RUN pnpm --filter "@just4kids/api..." run build
RUN --mount=type=cache,id=just4kids-pnpm,target=/pnpm/store \
    pnpm --filter @just4kids/api --prod deploy --store-dir=/pnpm/store /output/api

FROM node:24-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4000
COPY --from=builder --chown=node:node /output/api ./
RUN mkdir -p /app/uploads && chown node:node /app/uploads
USER node
EXPOSE 4000
CMD ["node", "dist/index.js"]
